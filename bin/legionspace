#!/usr/bin/env bash
# ==============================================================================
# Legion Space Linux GUI Launcher (v1.4.0)
# Native Rust Material You desktop application
# ==============================================================================
set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SCRIPT_SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" >/dev/null 2>&1 && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ $SCRIPT_SOURCE != /* ]] && SCRIPT_SOURCE="$DIR/$SCRIPT_SOURCE"
done
ROOT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")/.." >/dev/null 2>&1 && pwd)"

CANDIDATES=(
  "${ROOT_DIR}/legion-gui/target/release/legionspace"
  "${HOME}/.local/bin/legionspace"
  "/usr/local/bin/legionspace"
  "/usr/bin/legionspace"
)

BIN=""
for c in "${CANDIDATES[@]}"; do
  if [ -x "$c" ]; then
    BIN="$c"
    break
  fi
done

if [ -z "$BIN" ]; then
  if command -v legionspace >/dev/null 2>&1; then
    BIN="$(command -v legionspace)"
  fi
fi

if [ -z "$BIN" ]; then
  echo "Error: Native Legion Space GUI binary not found." >&2
  echo "Please build or install first: make build && make install-user" >&2
  exit 1
fi

exec "$BIN" "$@"
